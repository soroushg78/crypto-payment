# Server Configuration
PORT=8080
HOST=0.0.0.0
APP_ENV=development
LOG_LEVEL=info
READ_TIMEOUT_SECONDS=10
WRITE_TIMEOUT_SECONDS=15

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wallet_ledger?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_MINUTES=60
DB_MAX_CONN_IDLE_MINUTES=15

# Blockchain Direct Providers (Node / Validator RPC)
TON_API_KEY=
TON_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
# TRON_GRID_API_KEY=
# TRON_ENDPOINT=https://api.trongrid.io
